# WorkForce – Beispielkonfiguration. Nach .env kopieren, Werte setzen, Datei schützen (chmod 600).
# Diese Datei enthält bewusst KEINE Passwörter. Secrets gehören nicht ins Repository.

# --- Datenbank (nur im internen Docker-Netz erreichbar) --------------------------------------
POSTGRES_DB=workforce
POSTGRES_USER=workforce
# Pflicht: langes Zufallspasswort, z. B. `openssl rand -base64 32 | tr -d '/+=' | cut -c1-40`
POSTGRES_PASSWORD=

# --- Webzugang ---------------------------------------------------------------------------------
# Standard: nur lokal (127.0.0.1); der Reverse Proxy mit TLS leitet weiter.
WF_BIND_ADDRESS=127.0.0.1
WF_HTTP_PORT=8080
# true, sobald der Zugriff über HTTPS erfolgt (Standard). Nur für einen lokalen HTTP-Test auf false setzen.
WF_COOKIE_SECURE=true
WF_SESSION_HOURS=12

# --- Crawler ------------------------------------------------------------------------------------
# Pflicht für Scans: Kontakt des Betreibers (URL oder E-Mail). Er erscheint im User-Agent, damit
# Portalbetreiber Sie erreichen können. Ohne Angabe werden keine Scans geplant oder gestartet.
WF_CRAWLER_CONTACT=
WF_CRAWLER_NAME=WorkForceBot
WF_DEFAULT_REQUEST_INTERVAL_SECONDS=3
WF_HTTP_TIMEOUT_SECONDS=30
WF_HTTP_MAX_RETRIES=3
WF_RETRY_AFTER_MAX_SECONDS=600

# --- Zeitplan ------------------------------------------------------------------------------------
WF_TIMEZONE=Europe/Berlin
WF_SCAN_TIME=03:15
WF_STATS_CHECK_TIME=05:30

# --- Fachliche Regeln ----------------------------------------------------------------------------
WF_MISSING_SCANS_THRESHOLD=3
WF_STALE_AFTER_DAYS=14
WF_DETAIL_RECHECK_DAYS=7
WF_SMALL_COUNT_THRESHOLD=5

# --- Amtliche Statistik --------------------------------------------------------------------------
# Automatischer Abruf öffentlicher BA-Statistikdateien ist standardmäßig aktiv.
# Er benötigt WF_CRAWLER_CONTACT. Mit false abschalten; manueller Dateiimport bleibt verfügbar.
# Quellen- und Nutzungshinweise: docs/quellenregister.md. Dies aktiviert keine Stellenportal-Quelle.
WF_STATS_BA_AUTO=true
WF_STATS_KEEP_SOURCE_FILES=true

# --- Betrieb -------------------------------------------------------------------------------------
WF_WORKER_CONCURRENCY=2
WF_TECHNICAL_LOG_RETENTION_DAYS=90
WF_STALE_SOURCE_WARN_HOURS=36
WF_STOCK_CHANGE_WARN_PERCENT=30
WF_LOG_LEVEL=INFO
# Chromium im Image (für Tabellenexporte der amtlichen Statistik): 1 = ja, 0 = nein
WF_INSTALL_BROWSER=1
# Synthetische Testdaten sind im Produktionsmodus gesperrt, solange dies nicht ausdrücklich true ist.
WF_ALLOW_DEMO_DATA=false

# --- PostgreSQL-Speicher (Planungsannahme für 4 GB RAM, siehe docs/betrieb.md) ---------------------
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=32MB
